            {
              "id": "AWS-RDS-003",
              "name": "RdsAutomatedBackupsAreDisabled",
              "shortDescription": {
                "text": "RDS automated backups are disabled"
              },
              "fullDescription": {
                "text": "A backup retention period of 0 disables automated backups and point-in-time recovery."
              },
              "help": {
                "text": "A backup retention period of 0 disables automated backups and point-in-time recovery.\n\nRemediation:\nbackup_retention_period = 7  # or longer",
                "markdown": "A backup retention period of 0 disables automated backups and point-in-time recovery.\n\n**Remediation**\n\n```hcl\nbackup_retention_period = 7  # or longer\n```"
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#aws-rds-003",
