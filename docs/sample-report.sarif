                ],
                "precision": "high"
              }
            },
            {
              "id": "AZ-KV-001",
              "name": "KeyVaultPurgeProtectionIsDisabled",
              "shortDescription": {
                "text": "Key Vault purge protection is disabled"
              },
              "fullDescription": {
                "text": "Without purge protection, anyone with sufficient rights can permanently delete the vault and its keys during the soft-delete period, which can make encrypted data unrecoverable."
              },
              "help": {
                "text": "Without purge protection, anyone with sufficient rights can permanently delete the vault and its keys during the soft-delete period, which can make encrypted data unrecoverable.\n\nRemediation:\npurge_protection_enabled = true",
                "markdown": "Without purge protection, anyone with sufficient rights can permanently delete the vault and its keys during the soft-delete period, which can make encrypted data unrecoverable.\n\n**Remediation**\n\n```hcl\npurge_protection_enabled = true\n```"
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#az-kv-001",
              "defaultConfiguration": {
                "level": "note"
