                  "encryption"
                ],
                "precision": "high"
              }
            },
            {
              "id": "AWS-SQS-001",
              "name": "SqsQueueEncryptionIsDisabled",
              "shortDescription": {
                "text": "SQS queue encryption is disabled"
              },
              "fullDescription": {
                "text": "New queues use SQS-managed encryption by default; this queue explicitly turns it off and has no KMS key."
              },
              "help": {
                "text": "New queues use SQS-managed encryption by default; this queue explicitly turns it off and has no KMS key.\n\nRemediation:\nRemove sqs_managed_sse_enabled = false, or set kms_master_key_id.",
                "markdown": "New queues use SQS-managed encryption by default; this queue explicitly turns it off and has no KMS key.\n\n**Remediation**\n\nRemove sqs_managed_sse_enabled = false, or set kms_master_key_id."
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#aws-sqs-001",
              "defaultConfiguration": {
