              }
            },
            {
              "id": "AWS-REDSHIFT-001",
              "name": "RedshiftClusterIsPubliclyAccessible",
              "shortDescription": {
                "text": "Redshift cluster is publicly accessible"
              },
              "fullDescription": {
                "text": "A publicly accessible Redshift cluster can be reached from the internet, leaving only the security group between the data warehouse and attackers."
              },
              "help": {
                "text": "A publicly accessible Redshift cluster can be reached from the internet, leaving only the security group between the data warehouse and attackers.\n\nRemediation:\npublicly_accessible = false",
                "markdown": "A publicly accessible Redshift cluster can be reached from the internet, leaving only the security group between the data warehouse and attackers.\n\n**Remediation**\n\n```hcl\npublicly_accessible = false\n```"
              },
