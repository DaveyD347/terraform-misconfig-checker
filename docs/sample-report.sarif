                  "terraform",
                  "azure",
                  "encryption"
                ],
                "precision": "high"
              }
            },
            {
              "id": "AZ-STORAGE-003",
              "name": "StorageAccountAllowsTlsVersionsOlderThan",
              "shortDescription": {
                "text": "Storage account allows TLS versions older than 1.2"
              },
              "fullDescription": {
                "text": "TLS 1.0 and 1.1 are deprecated and Azure is retiring support for them."
              },
              "help": {
                "text": "TLS 1.0 and 1.1 are deprecated and Azure is retiring support for them.\n\nRemediation:\nmin_tls_version = \"TLS1_2\"",
                "markdown": "TLS 1.0 and 1.1 are deprecated and Azure is retiring support for them.\n\n**Remediation**\n\n```hcl\nmin_tls_version = \"TLS1_2\"\n```"
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#az-storage-003",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "terraform",
                  "azure",
                  "encryption"
                ],
                "precision": "high"
              }
            },
            {
              "id": "GCP-COMPUTE-001",
              "name": "InstanceUsesTheDefaultServiceAccountWithFullApiAccess",
              "shortDescription": {
                "text": "Instance uses the default service account with full API access"
              },
              "fullDescription": {
                "text": "The Compute Engine default service account has the Editor role in many projects. Combined with the cloud-platform scope, any code running on the VM can manage most of the project."
              },
              "help": {
                "text": "The Compute Engine default service account has the Editor role in many projects. Combined with the cloud-platform scope, any code running on the VM can manage most of the project.\n\nRemediation:\nCreate a dedicated service account with only the roles the workload needs, and attach it with that email.",
                "markdown": "The Compute Engine default service account has the Editor role in many projects. Combined with the cloud-platform scope, any code running on the VM can manage most of the project.\n\n**Remediation**\n\nCreate a dedicated service account with only the roles the workload needs, and attach it with that email."
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#gcp-compute-001",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "terraform",
                  "gcp",
                  "iam",
                  "credentials"
                ],
                "precision": "high"
              }
            },
            {
              "id": "GCP-IAM-001",
              "name": "ProjectOrOrganizationIamGrantsARoleToThePublic",
              "shortDescription": {
                "text": "Project or organization IAM grants a role to the public"
              },
              "fullDescription": {
                "text": "Granting any role on a project, folder or organization to allUsers or allAuthenticatedUsers gives that access to everyone with (or without) a Google account."
              },
              "help": {
                "text": "Granting any role on a project, folder or organization to allUsers or allAuthenticatedUsers gives that access to everyone with (or without) a Google account.\n\nRemediation:\nGrant the role to specific identities instead.",
                "markdown": "Granting any role on a project, folder or organization to allUsers or allAuthenticatedUsers gives that access to everyone with (or without) a Google account.\n\n**Remediation**\n\nGrant the role to specific identities instead."
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#gcp-iam-001",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "terraform",
                  "gcp",
                  "iam",
                  "data-exposure"
                ],
                "precision": "high"
              }
            },
            {
              "id": "GCP-IAM-002",
              "name": "PrimitiveOwnerOrEditorRoleIsGranted",
              "shortDescription": {
                "text": "Primitive owner or editor role is granted"
              },
              "fullDescription": {
                "text": "The basic Owner and Editor roles include thousands of permissions across every service. Google recommends predefined or custom roles instead."
              },
              "help": {
                "text": "The basic Owner and Editor roles include thousands of permissions across every service. Google recommends predefined or custom roles instead.\n\nRemediation:\nReplace roles/owner and roles/editor with predefined roles scoped to the services the identity uses.",
                "markdown": "The basic Owner and Editor roles include thousands of permissions across every service. Google recommends predefined or custom roles instead.\n\n**Remediation**\n\nReplace roles/owner and roles/editor with predefined roles scoped to the services the identity uses."
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#gcp-iam-002",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "terraform",
                  "gcp",
                  "iam",
                  "least-privilege"
                ],
                "precision": "high"
              }
            },
            {
              "id": "GCP-NET-001",
              "name": "FirewallRuleAllowsInternetTrafficToSensitivePorts",
              "shortDescription": {
                "text": "Firewall rule allows internet traffic to sensitive ports"
              },
              "fullDescription": {
                "text": "An ingress rule from 0.0.0.0/0 to SSH, RDP or database ports exposes every matching instance to the internet. Rules that allow every port are reported as critical."
              },
              "help": {
                "text": "An ingress rule from 0.0.0.0/0 to SSH, RDP or database ports exposes every matching instance to the internet. Rules that allow every port are reported as critical.\n\nRemediation:\nRestrict source_ranges, and use Identity-Aware Proxy TCP forwarding (35.235.240.0/20) for SSH and RDP.",
                "markdown": "An ingress rule from 0.0.0.0/0 to SSH, RDP or database ports exposes every matching instance to the internet. Rules that allow every port are reported as critical.\n\n**Remediation**\n\nRestrict source_ranges, and use Identity-Aware Proxy TCP forwarding (35.235.240.0/20) for SSH and RDP."
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#gcp-net-001",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "terraform",
                  "gcp",
                  "network"
                ],
                "precision": "high"
              }
            },
            {
              "id": "GCP-SQL-001",
              "name": "CloudSqlInstanceIsOpenToTheInternet",
              "shortDescription": {
                "text": "Cloud SQL instance is open to the internet"
              },
              "fullDescription": {
                "text": "An authorized network of 0.0.0.0/0 lets any IP address connect to the instance's public IP and try to log in."
              },
              "help": {
                "text": "An authorized network of 0.0.0.0/0 lets any IP address connect to the instance's public IP and try to log in.\n\nRemediation:\nRemove the 0.0.0.0/0 authorized network; use private IP or the Cloud SQL Auth Proxy instead.",
                "markdown": "An authorized network of 0.0.0.0/0 lets any IP address connect to the instance's public IP and try to log in.\n\n**Remediation**\n\nRemove the 0.0.0.0/0 authorized network; use private IP or the Cloud SQL Auth Proxy instead."
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#gcp-sql-001",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "terraform",
                  "gcp",
                  "network"
                ],
                "precision": "high"
              }
            },
            {
              "id": "GCP-SQL-002",
              "name": "CloudSqlInstanceDoesNotRequireSsl",
              "shortDescription": {
                "text": "Cloud SQL instance does not require SSL"
              },
              "fullDescription": {
                "text": "Unless SSL is enforced, clients can connect to the public IP over an unencrypted connection."
              },
              "help": {
                "text": "Unless SSL is enforced, clients can connect to the public IP over an unencrypted connection.\n\nRemediation:\nsettings {\n  ip_configuration {\n    ssl_mode = \"ENCRYPTED_ONLY\"\n  }\n}",
                "markdown": "Unless SSL is enforced, clients can connect to the public IP over an unencrypted connection.\n\n**Remediation**\n\n```hcl\nsettings {\n  ip_configuration {\n    ssl_mode = \"ENCRYPTED_ONLY\"\n  }\n}\n```"
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#gcp-sql-002",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "terraform",
                  "gcp",
                  "encryption"
                ],
                "precision": "high"
              }
            },
            {
              "id": "GCP-STORAGE-001",
              "name": "CloudStorageBucketIsPubliclyAccessible",
              "shortDescription": {
                "text": "Cloud Storage bucket is publicly accessible"
              },
              "fullDescription": {
                "text": "Granting a role to allUsers or allAuthenticatedUsers makes the bucket readable (or writable) by anyone with a Google account or no account at all."
              },
              "help": {
                "text": "Granting a role to allUsers or allAuthenticatedUsers makes the bucket readable (or writable) by anyone with a Google account or no account at all.\n\nRemediation:\nGrant roles to specific users, groups or service accounts. Enable public access prevention on the bucket:\n\npublic_access_prevention = \"enforced\"",
                "markdown": "Granting a role to allUsers or allAuthenticatedUsers makes the bucket readable (or writable) by anyone with a Google account or no account at all.\n\n**Remediation**\n\nGrant roles to specific users, groups or service accounts. Enable public access prevention on the bucket:\n\n```hcl\npublic_access_prevention = \"enforced\"\n```"
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#gcp-storage-001",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "terraform",
                  "gcp",
                  "data-exposure"
                ],
                "precision": "high"
              }
            },
            {
              "id": "GCP-STORAGE-002",
              "name": "CloudStorageBucketDoesNotUseUniformBucketLevelAccess",
              "shortDescription": {
                "text": "Cloud Storage bucket does not use uniform bucket-level access"
              },
              "fullDescription": {
                "text": "With fine-grained ACLs, individual objects can be made public even when bucket IAM looks locked down. Uniform bucket-level access makes IAM the only access control."
              },
              "help": {
                "text": "With fine-grained ACLs, individual objects can be made public even when bucket IAM looks locked down. Uniform bucket-level access makes IAM the only access control.\n\nRemediation:\nuniform_bucket_level_access = true",
                "markdown": "With fine-grained ACLs, individual objects can be made public even when bucket IAM looks locked down. Uniform bucket-level access makes IAM the only access control.\n\n**Remediation**\n\n```hcl\nuniform_bucket_level_access = true\n```"
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#gcp-storage-002",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "security-severity": "3.0",
                "tags": [
                  "security",
                  "terraform",
                  "gcp",
                  "data-exposure"
                ],
                "precision": "high"
              }
            }
          ]
        }
