                "tags": [
                  "security",
                  "terraform",
                  "azure",
                  "resilience"
                ],
                "precision": "high"
              }
            },
            {
              "id": "AZ-NET-001",
              "name": "NetworkSecurityGroupAllowsInboundInternetTrafficToSensitivePorts",
              "shortDescription": {
                "text": "Network security group allows inbound internet traffic to sensitive ports"
              },
              "fullDescription": {
                "text": "An Allow rule from \"*\", \"Internet\" or 0.0.0.0/0 to SSH, RDP, WinRM or database ports exposes them to constant scanning and brute force. Rules that open every port are reported as critical."
              },
              "help": {
                "text": "An Allow rule from \"*\", \"Internet\" or 0.0.0.0/0 to SSH, RDP, WinRM or database ports exposes them to constant scanning and brute force. Rules that open every port are reported as critical.\n\nRemediation:\nLimit source_address_prefix to known ranges, and use Azure Bastion or just-in-time VM access for administration.",
                "markdown": "An Allow rule from \"*\", \"Internet\" or 0.0.0.0/0 to SSH, RDP, WinRM or database ports exposes them to constant scanning and brute force. Rules that open every port are reported as critical.\n\n**Remediation**\n\nLimit source_address_prefix to known ranges, and use Azure Bastion or just-in-time VM access for administration."
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#az-net-001",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "terraform",
                  "azure",
                  "network"
                ],
                "precision": "high"
              }
            },
            {
              "id": "AZ-SQL-001",
              "name": "DatabaseFirewallRuleAllowsTheEntireInternet",
              "shortDescription": {
                "text": "Database firewall rule allows the entire internet"
              },
              "fullDescription": {
                "text": "A firewall rule from 0.0.0.0 to 255.255.255.255 lets every IP address on the internet attempt to log in to the database server."
              },
              "help": {
                "text": "A firewall rule from 0.0.0.0 to 255.255.255.255 lets every IP address on the internet attempt to log in to the database server.\n\nRemediation:\nAllow only the client ranges that need access, or use private endpoints.",
                "markdown": "A firewall rule from 0.0.0.0 to 255.255.255.255 lets every IP address on the internet attempt to log in to the database server.\n\n**Remediation**\n\nAllow only the client ranges that need access, or use private endpoints."
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#az-sql-001",
