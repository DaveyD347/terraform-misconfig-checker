            },
            {
              "id": "AWS-OS-001",
              "name": "OpensearchDomainIsNotEncryptedAtRest",
              "shortDescription": {
                "text": "OpenSearch domain is not encrypted at rest"
              },
              "fullDescription": {
                "text": "Search domains often hold copies of application logs and customer data. Encryption at rest protects indices, logs, swap files and snapshots."
              },
              "help": {
                "text": "Search domains often hold copies of application logs and customer data. Encryption at rest protects indices, logs, swap files and snapshots.\n\nRemediation:\nencrypt_at_rest {\n  enabled = true\n}",
                "markdown": "Search domains often hold copies of application logs and customer data. Encryption at rest protects indices, logs, swap files and snapshots.\n\n**Remediation**\n\n```hcl\nencrypt_at_rest {\n  enabled = true\n}\n```"
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#aws-os-001",
              "defaultConfiguration": {
                "level": "warning"
