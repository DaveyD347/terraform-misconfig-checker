              }
            },
            {
              "id": "AWS-LAMBDA-001",
              "name": "LambdaFunctionUrlHasNoAuthentication",
              "shortDescription": {
                "text": "Lambda function URL has no authentication"
              },
              "fullDescription": {
                "text": "authorization_type = \"NONE\" makes the function callable by anyone with the URL. That is sometimes intended for webhooks, but it should be a conscious, documented choice."
              },
              "help": {
                "text": "authorization_type = \"NONE\" makes the function callable by anyone with the URL. That is sometimes intended for webhooks, but it should be a conscious, documented choice.\n\nRemediation:\nauthorization_type = \"AWS_IAM\"  # or suppress with a reason if public by design",
                "markdown": "authorization_type = \"NONE\" makes the function callable by anyone with the URL. That is sometimes intended for webhooks, but it should be a conscious, documented choice.\n\n**Remediation**\n\n```hcl\nauthorization_type = \"AWS_IAM\"  # or suppress with a reason if public by design\n```"
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#aws-lambda-001",
              "defaultConfiguration": {
