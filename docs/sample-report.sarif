                  "aws",
                  "encryption"
                ],
                "precision": "high"
              }
            },
            {
              "id": "AWS-RDS-001",
              "name": "RdsStorageIsNotEncrypted",
              "shortDescription": {
                "text": "RDS storage is not encrypted"
              },
              "fullDescription": {
                "text": "Unencrypted database storage, snapshots and read replicas expose data at rest. Encryption can only be enabled when the database is created, so it is expensive to fix later."
              },
              "help": {
                "text": "Unencrypted database storage, snapshots and read replicas expose data at rest. Encryption can only be enabled when the database is created, so it is expensive to fix later.\n\nRemediation:\nstorage_encrypted = true\nkms_key_id        = aws_kms_key.rds.arn  # optional customer managed key",
                "markdown": "Unencrypted database storage, snapshots and read replicas expose data at rest. Encryption can only be enabled when the database is created, so it is expensive to fix later.\n\n**Remediation**\n\n```hcl\nstorage_encrypted = true\nkms_key_id        = aws_kms_key.rds.arn  # optional customer managed key\n```"
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#aws-rds-001",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "terraform",
                  "aws",
                  "encryption"
                ],
                "precision": "high"
              }
            },
            {
              "id": "AWS-RDS-002",
              "name": "RdsInstanceIsPubliclyAccessible",
              "shortDescription": {
                "text": "RDS instance is publicly accessible"
              },
              "fullDescription": {
                "text": "publicly_accessible = true gives the database a public DNS name and IP, leaving only the security group between it and the internet."
              },
              "help": {
                "text": "publicly_accessible = true gives the database a public DNS name and IP, leaving only the security group between it and the internet.\n\nRemediation:\npublicly_accessible = false",
                "markdown": "publicly_accessible = true gives the database a public DNS name and IP, leaving only the security group between it and the internet.\n\n**Remediation**\n\n```hcl\npublicly_accessible = false\n```"
              },
              "helpUri": "https://github.com/DaveyD347/terraform-misconfig-checker/blob/main/docs/rules.md#aws-rds-002",
